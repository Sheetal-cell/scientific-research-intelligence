# Primary and secondary Google Gemini models
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Independent backup provider. Create a free key at https://console.groq.com/keys
# Leave empty to disable Groq fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAlex API key
OPENALEX_API_KEY=

# Comma-separated frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for AI planning, filtering, evidence extraction and report generation
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: improves OpenAlex polite-pool identification
OPENALEX_MAILTO=your_email@example.com

# Comma-separated frontend origins. Vercel preview domains are also allowed.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
